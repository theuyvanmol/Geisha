{
	"name": "geisha-2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"seed": "vite-node src/lib/server/db/seed.ts",
		"media": "node scripts/optimize-media.mjs && node scripts/optimize-video.mjs",
		"media:force": "node scripts/optimize-media.mjs --force && node scripts/optimize-video.mjs --force",
		"media:upload": "node --env-file=.env scripts/upload-r2.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@types/node": "^25.9.1",
		"heic-convert": "^2.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^7.3.6",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/functions": "^3.7.5",
		"@xyflow/svelte": "^1.6.0",
		"aws4fetch": "^1.0.20",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"lenis": "^1.3.23",
		"pocketbase": "^0.27.0",
		"sharp": "^0.35.3",
		"zod": "^4.4.3"
	}
}
